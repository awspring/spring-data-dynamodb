<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.awspring.cloud</groupId>
		<artifactId>spring-data-dynamodb-parent</artifactId>
		<version>1.0.0</version>
	</parent>

	<artifactId>spring-data-dynamodb-docs</artifactId>
	<packaging>pom</packaging>

	<name>Spring Data DynamoDB - Docs</name>
	<description>Reference documentation for Spring Data DynamoDB</description>

	<properties>
		<!-- Documentation module: nothing to deploy to a Maven repository. -->
		<maven.deploy.skip>true</maven.deploy.skip>
		<maven.install.skip>true</maven.install.skip>

		<asciidoctor-maven-plugin.version>3.0.0</asciidoctor-maven-plugin.version>
		<spring-asciidoctor-backends.version>0.0.7</spring-asciidoctor-backends.version>
		<asciidoctorj.version>2.5.13</asciidoctorj.version>

		<refdocs.build.directory>${project.build.directory}/refdocs</refdocs.build.directory>
		<generated-docs.dir>${project.build.directory}/generated-docs</generated-docs.dir>

		<generate-docs.phase>prepare-package</generate-docs.phase>
		<convert-markdown.phase>generate-resources</convert-markdown.phase>
	</properties>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-deploy-plugin</artifactId>
				<configuration>
					<skip>true</skip>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
			Renders the reference documentation using Spring's official Asciidoctor styling.
			Activated by `make docs` (or `-Pdocs`).
		-->
		<profile>
			<id>docs</id>
			<build>
				<plugins>
					<!-- Convert Markdown to Asciidoc using Ant/bash -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>3.1.0</version>
						<executions>
							<execution>
								<id>convert-markdown-to-asciidoc</id>
								<phase>${convert-markdown.phase}</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target>
										<mkdir dir="${refdocs.build.directory}"/>
										<exec executable="bash" failonerror="true">
											<arg value="-c"/>
											<arg value="pandoc '${project.basedir}/src/main/content/reference.md' -f markdown -t asciidoc -o '${refdocs.build.directory}/reference.adoc' --wrap=none"/>
										</exec>
										<echo message="Converted Markdown to Asciidoc"/>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>

					<plugin>
						<groupId>org.asciidoctor</groupId>
						<artifactId>asciidoctor-maven-plugin</artifactId>
						<version>${asciidoctor-maven-plugin.version}</version>
						<dependencies>
							<dependency>
								<groupId>io.spring.asciidoctor.backends</groupId>
								<artifactId>spring-asciidoctor-backends</artifactId>
								<version>${spring-asciidoctor-backends.version}</version>
							</dependency>
						</dependencies>
						<configuration>
							<sourceDirectory>${refdocs.build.directory}</sourceDirectory>
							<resources>
								<resource>
									<directory>${refdocs.build.directory}</directory>
									<excludes>
										<exclude>**/*.adoc</exclude>
									</excludes>
								</resource>
							</resources>
							<!-- Common attributes for all executions -->
							<attributes>
								<docinfo>shared</docinfo>
								<allow-uri-read>true</allow-uri-read>
								<nofooter/>
								<toc>left</toc>
								<toc-levels>4</toc-levels>
								<sectlinks>true</sectlinks>
								
								<!-- Project metadata -->
								<project-version>${project.version}</project-version>
								<project-name>Spring Data DynamoDB</project-name>
								<github-project>https://github.com/awspring/spring-data-dynamodb</github-project>
								<github-issues>https://github.com/awspring/spring-data-dynamodb/issues</github-issues>
								
								<!-- Syntax highlighting -->
								<source-highlighter>highlight.js</source-highlighter>
							</attributes>
						</configuration>
						<executions>
							<execution>
								<id>generate-html-documentation</id>
								<phase>${generate-docs.phase}</phase>
								<goals>
									<goal>process-asciidoc</goal>
								</goals>
								<configuration>
									<backend>spring-html</backend>
									<sourceDocumentName>reference.adoc</sourceDocumentName>
									<outputDirectory>${generated-docs.dir}/reference/html</outputDirectory>
									<doctype>book</doctype>
									<attributes>
										<docinfo>shared</docinfo>
										<stylesdir>css/</stylesdir>
										<stylesheet>site.css</stylesheet>
										<linkcss>true</linkcss>
										<icons>font</icons>
										<highlightjsdir>js/highlight</highlightjsdir>
										<highlightjs-theme>github</highlightjs-theme>
										<imagesdir>./images</imagesdir>
										<attribute-missing>warn</attribute-missing>
									</attributes>
									<logHandler>
										<outputToConsole>true</outputToConsole>
										<failIf>
											<severity>WARN</severity>
										</failIf>
									</logHandler>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
